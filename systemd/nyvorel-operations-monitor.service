[Unit]
Description=Nyvorel Operations Center monitor
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/quickshell/nyvorel/scripts/operations-center/operations.py monitor
Restart=on-failure
RestartSec=2
Nice=10
NoNewPrivileges=true
# Required for listener-owner correlation via /proc/net + /proc/<pid>/fd.
PrivateTmp=false

[Install]
WantedBy=default.target
